<!-- ============================================================ -->
<!-- GLOBAL CONFIG & UTILITIES                                      -->
<!-- ============================================================ -->
<script>
    // ✅ V8.8.2: Global config — semua dibungkus supaya tidak error kalau undefined
    window.BASE_URL    = '<?= defined("BASE_URL") ? BASE_URL : (defined("API_URL") ? API_URL : "http://localhost:3000") ?>';
    window.API_URL     = '<?= defined("API_URL") ? API_URL : "http://localhost:3000/api" ?>';
    window.MAX_FILE_SIZE = <?= defined("MAX_FILE_SIZE") ? (int)MAX_FILE_SIZE : 524288000 ?>;
    window.IS_LOGGED_IN = <?= !empty($isLoggedIn) ? 'true' : 'false' ?>;
    window.IS_ADMIN    = <?= !empty($isAdmin) ? 'true' : 'false' ?>;
    window.USER_PLAN   = '<?= htmlspecialchars($userPlan, ENT_QUOTES) ?>';
    window.APP_NAME_JS = '<?= APP_NAME ?>';
    window.APP_VERSION_JS = '<?= APP_VERSION ?>';

    // Shortcut untuk kompatibilitas dengan kode lama (main.js, autoclip.js)
    // V2.0.0: DUPLICATE removed — already in header.php
// const BASE_URL = window.BASE_URL;
    // V2.0.0: DUPLICATE removed — already in header.php
// const API_URL = window.API_URL;
    // V2.0.0: DUPLICATE removed — already in header.php
// const MAX_FILE_SIZE = window.MAX_FILE_SIZE;
    // V2.0.0: DUPLICATE removed — already declared in header.php
// const IS_LOGGED_IN = window.IS_LOGGED_IN;
    // V2.0.0: DUPLICATE removed — already declared in header.php
// const IS_ADMIN = window.IS_ADMIN;
    window.USER_PLAN   = '<?= htmlspecialchars($userPlan, ENT_QUOTES) ?>';
    const APP_NAME_JS = window.APP_NAME_JS;
    const APP_VERSION_JS = window.APP_VERSION_JS;

    // V8.7.0 SECURITY: clipora_token & cookie auth lain sekarang HttpOnly
    const PROTECTED_COOKIES = ['clipora_token', 'clipora_username', 'clipora_plan', 'clipora_is_admin'];

    function getCookie(name) {
        if (PROTECTED_COOKIES.includes(name)) {
            return (window.CLIPORA_AUTH && window.CLIPORA_AUTH.token) || null;
        }
        const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
        return match ? decodeURIComponent(match[2]) : null;
    }

    function setCookie(name, value, days = 7) {
        if (PROTECTED_COOKIES.includes(name)) {
            console.warn(`[Security] ${name} adalah HttpOnly, tidak bisa di-set dari JS.`);
            return;
        }
        const expires = new Date(Date.now() + days * 86400000).toUTCString();
        document.cookie = `${name}=${encodeURIComponent(value)}; expires=${expires}; path=/; SameSite=Lax`;
    }

    function deleteCookie(name) {
        if (PROTECTED_COOKIES.includes(name)) {
            console.warn(`[Security] ${name} adalah HttpOnly, harus dihapus dari server.`);
            return;
        }
        document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/`;
    }

    // V8.8.2: Expose AUTH_TOKEN ke window supaya main.js & autoclip.js bisa baca
    window.AUTH_TOKEN = (window.CLIPORA_AUTH && window.CLIPORA_AUTH.token) || null;
    let AUTH_TOKEN = window.AUTH_TOKEN;

    // ============ TOAST ============
    function showToast(message, type = 'info', duration = 4000) {
        const container = document.getElementById('toastContainer');
        if (!container) return;
        const icons = {
            success: 'fa-check-circle',
            error: 'fa-times-circle',
            warning: 'fa-exclamation-triangle',
            info: 'fa-info-circle'
        };
        const toast = document.createElement('div');
        toast.className = `toast toast-${type}`;
        toast.innerHTML = `<i class="fas ${icons[type] || icons.info}"></i><span>${message}</span><button class="toast-close" aria-label="Tutup">&times;</button>`;
        container.appendChild(toast);
        setTimeout(() => toast.classList.add('show'), 10);
        const closeToast = () => {
            toast.classList.remove('show');
            setTimeout(() => toast.remove(), 300);
        };
        toast.querySelector('.toast-close').addEventListener('click', closeToast);
        if (duration > 0) setTimeout(closeToast, duration);
    }
    window.toastSuccess = (msg) => showToast(msg, 'success');
    window.toastError = (msg) => showToast(msg, 'error');
    window.toastWarning = (msg) => showToast(msg, 'warning');
    window.toastInfo = (msg) => showToast(msg, 'info');

    // ============ CONFIRM ============
    function showConfirm(options = {}) {
        return new Promise((resolve) => {
            const overlay = document.getElementById('confirmOverlay');
            const title = document.getElementById('confirmTitle');
            const message = document.getElementById('confirmMessage');
            const icon = document.getElementById('confirmIcon');
            const okBtn = document.getElementById('confirmOk');
            const cancelBtn = document.getElementById('confirmCancel');
            if (!overlay) {
                resolve(false);
                return;
            }

            title.textContent = options.title || 'Konfirmasi';
            message.textContent = options.message || 'Apakah Anda yakin?';
            const iconMap = {
                warning: 'fa-exclamation-triangle',
                danger: 'fa-exclamation-circle',
                info: 'fa-question-circle'
            };
            const iconType = options.type || 'info';
            icon.className = `fas ${iconMap[iconType] || iconMap.info}`;
            okBtn.textContent = options.okText || 'Ya, Lanjutkan';
            cancelBtn.textContent = options.cancelText || 'Batal';
            okBtn.style.background = iconType === 'danger' ?
                'linear-gradient(135deg, #ef4444, #dc2626)' :
                'linear-gradient(135deg, var(--primary), var(--primary-dark))';
            overlay.classList.add('active');

            const cleanup = () => {
                overlay.classList.remove('active');
                okBtn.removeEventListener('click', onOk);
                cancelBtn.removeEventListener('click', onCancel);
                overlay.removeEventListener('click', onOverlay);
            };
            const onOk = () => { cleanup(); resolve(true); };
            const onCancel = () => { cleanup(); resolve(false); };
            const onOverlay = (e) => { if (e.target === overlay) onCancel(); };
            okBtn.addEventListener('click', onOk);
            cancelBtn.addEventListener('click', onCancel);
            overlay.addEventListener('click', onOverlay);
        });
    }
    window.showConfirm = showConfirm;

    // ============ LOADING ============
    function showLoading(text = 'Memuat...') {
        const el = document.getElementById('globalLoading');
        const txt = document.getElementById('globalLoadingText');
        if (el) {
            if (txt) txt.textContent = text;
            el.classList.add('active');
        }
    }
    function hideLoading() {
        const el = document.getElementById('globalLoading');
        if (el) el.classList.remove('active');
    }
    window.showLoading = showLoading;
    window.hideLoading = hideLoading;

    // ============ API FETCH ============
    async function apiFetch(url, options = {}) {
        try {
            options.headers = options.headers || {};
            if (AUTH_TOKEN && !options.headers['Authorization']) {
                options.headers['Authorization'] = 'Bearer ' + AUTH_TOKEN;
            }
            const response = await fetch(url, { cache: 'no-store', ...options });
            if (response.status === 401) {
                const isAuthEndpoint = url.includes('/auth/login') || url.includes('/auth/register');
                if (!isAuthEndpoint) {
                    toastWarning('Sesi Anda telah berakhir. Silakan login kembali.');
                    setTimeout(() => {
                        window.location.href = 'logout.php';
                    }, 2000);
                    throw new Error('Session expired');
                }
            }
            return response;
        } catch (error) {
            if (error.message !== 'Session expired') console.error('API Error:', error);
            throw error;
        }
    }
    window.apiFetch = apiFetch;

    // ============ LOGOUT ============
    async function logoutUser(e) {
        if (e) e.preventDefault();
        const confirmed = await showConfirm({
            title: 'Logout',
            message: 'Apakah Anda yakin ingin keluar dari akun Anda?',
            type: 'warning',
            okText: 'Ya, Logout'
        });
        if (!confirmed) return;

        try {
            await fetch(`${API_URL}/auth/logout`, {
                method: 'POST',
                headers: AUTH_TOKEN ? { 'Authorization': 'Bearer ' + AUTH_TOKEN } : {}
            });
        } catch (err) {
            console.warn('Logout API error:', err);
        }

        toastSuccess('Anda berhasil logout');
        setTimeout(() => window.location.href = 'logout.php', 500);
    }
    window.logoutUser = logoutUser;

    // ============ BACK TO TOP ============
    const backToTopBtn = document.getElementById('backToTop');
    if (backToTopBtn) {
        window.addEventListener('scroll', () => {
            if (window.scrollY > 400) backToTopBtn.classList.add('show');
            else backToTopBtn.classList.remove('show');
        });
        backToTopBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    }

    // ============ KEYBOARD SHORTCUT ============
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            document.querySelectorAll('.modal-overlay.active, .confirm-overlay.active').forEach(el => {
                el.classList.remove('active');
            });
        }
    });

    // ============ NETWORK STATUS ============
    window.addEventListener('online', () => toastSuccess('Koneksi kembali online'));
    window.addEventListener('offline', () => toastError('Koneksi internet terputus'));

    // ============ CONSOLE BRANDING ============
    console.log(`%c🚀 ${APP_NAME_JS} ${APP_VERSION_JS}`,
        'color: #f59e0b; font-size: 20px; font-weight: bold; padding: 8px;'
    );
    console.log('%cCreate Better Videos with AI', 'color: #94a3b8; font-size: 12px;');
</script>

