<!-- ============================================================ -->
<!-- V8.8.2: SOCKET EXPOSE FALLBACK                                 -->
<!-- Kalau main.js belum expose window.socket, kita patch di sini   -->
<!-- ============================================================ -->
<script>
    (function() {
        let tries = 0;
        const iv = setInterval(() => {
            tries++;
            // Coba akses `socket` dari scope global (main.js pakai `let socket`)
            // Kalau sudah ada tapi belum di-expose ke window, kita expose
            try {
                if (typeof socket !== 'undefined' && socket && socket.on && !window.socket) {
                    window.socket = socket;
                    console.log('🔌 [Footer] Fallback: exposed socket to window.socket');
                    clearInterval(iv);
                    return;
                }
            } catch (e) { /* socket belum dideklarasi */ }

            if (tries > 30) clearInterval(iv); // 30 × 200ms = 6 detik
        }, 200);
    })();
</script>

