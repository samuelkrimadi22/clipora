        .te-preview-badge {
            position: absolute;
            top: 12px;
            left: 12px;
            background: linear-gradient(135deg, #22c55e, #16a34a);
            color: white;
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.8px;
            padding: 6px 12px;
            border-radius: 20px;
            z-index: 5;
            animation: tePreviewPulse 1.5s ease-in-out infinite;
            box-shadow: 0 4px 16px rgba(34, 197, 94, 0.5);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        @keyframes tePreviewPulse {

            0%,
            100% {
                transform: scale(1);
                box-shadow: 0 4px 16px rgba(34, 197, 94, 0.5);
            }

            50% {
                transform: scale(1.04);
                box-shadow: 0 6px 24px rgba(34, 197, 94, 0.8);
            }
        }


        .te-quick-mode {
            margin: 0 0 20px;
            padding: 16px;
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.06), rgba(6, 182, 212, 0.06));
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 14px;
        }

        .te-qm-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 14px;
            font-size: 0.85rem;
            color: var(--text);
            font-weight: 700;
            flex-wrap: wrap;
        }

        .te-qm-header i {
            color: #8b5cf6;
            font-size: 1rem;
        }

        .te-qm-header small {
            font-weight: 400;
            color: var(--text-muted);
            font-size: 0.74rem;
        }

        .te-qm-buttons {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
        }

        .te-qm-btn {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 6px;
            padding: 16px 10px 14px;
            border-radius: 12px;
            border: 1.5px solid rgba(255, 255, 255, 0.08);
            background: rgba(255, 255, 255, 0.03);
            color: var(--text-muted);
            cursor: pointer;
            transition: 0.25s;
            font-family: inherit;
        }

        .te-qm-btn:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(255, 255, 255, 0.15);
            transform: translateY(-2px);
        }

        .te-qm-btn.active {
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.18), rgba(6, 182, 212, 0.12));
            border-color: rgba(139, 92, 246, 0.55);
            box-shadow: 0 4px 16px rgba(139, 92, 246, 0.25);
            transform: translateY(-2px);
        }

        .te-qm-icon {
            font-size: 1.8rem;
            line-height: 1;
            transition: 0.25s;
        }

        .te-qm-btn.active .te-qm-icon {
            transform: scale(1.1);
        }

        .te-qm-text {
            display: flex;
            flex-direction: column;
            gap: 3px;
            width: 100%;
        }

        .te-qm-text strong {
            font-size: 0.9rem;
            font-weight: 800;
            color: var(--text);
            letter-spacing: 0.2px;
        }

        .te-qm-btn.active .te-qm-text strong {
            color: #c4b5fd;
        }

        .te-qm-text small {
            font-size: 0.68rem;
            line-height: 1.35;
            opacity: 0.75;
        }

        .te-qm-badge {
            position: absolute;
            top: 8px;
            right: 8px;
            font-size: 0.56rem;
            font-weight: 800;
            padding: 2px 6px;
            border-radius: 8px;
            background: rgba(139, 92, 246, 0.15);
            color: #a78bfa;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .te-qm-btn.active .te-qm-badge {
            background: rgba(139, 92, 246, 0.35);
            color: #ddd6fe;
        }

        .te-legend-compact {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 12px;
            font-size: 0.78rem;
            color: var(--text-muted);
            padding: 10px 14px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.06);
            flex-wrap: wrap;
        }

        .te-legend-item {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .te-legend-item strong {
            color: var(--text);
            font-weight: 700;
        }

        .te-legend-sep {
            color: rgba(255, 255, 255, 0.2);
        }

        .te-legend-dot {
            display: inline-block;
            width: 14px;
            height: 14px;
            border-radius: 4px;
            flex-shrink: 0;
        }

        .te-legend-dot.cut {
            background: rgba(239, 68, 68, 0.4);
            border: 2px solid rgba(239, 68, 68, 0.95);
            box-shadow: 0 0 8px rgba(239, 68, 68, 0.4);
        }

        .te-legend-dot.keep {
            background: transparent;
            border: 2px dashed rgba(255, 255, 255, 0.35);
        }

        .te-timeline-viewport {
            overflow-x: auto;
            overflow-y: hidden;
            padding-bottom: 10px;
            scrollbar-width: thin;
            scrollbar-color: rgba(139, 92, 246, 0.5) rgba(0, 0, 0, 0.2);
        }

        .te-timeline-viewport::-webkit-scrollbar {
            height: 10px;
        }

        .te-timeline-viewport::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.2);
            border-radius: 5px;
        }

        .te-timeline-viewport::-webkit-scrollbar-thumb {
            background: rgba(139, 92, 246, 0.5);
            border-radius: 5px;
        }

        .te-timeline-zoom-wrap {
            min-width: 100%;
            transition: width 0.15s ease;
        }

        .te-timeline-section {
            margin-bottom: 20px;
        }

        .te-time-ruler {
            display: flex;
            justify-content: space-between;
            font-size: 0.68rem;
            color: var(--text-muted);
            padding: 0 4px;
            margin-bottom: 6px;
            font-family: 'Courier New', monospace;
            height: 16px;
            position: relative;
        }

        .te-time-mark {
            position: absolute;
            transform: translateX(-50%);
            white-space: nowrap;
        }

        .te-time-mark:first-child {
            transform: translateX(0);
        }

        .te-time-mark:last-child {
            transform: translateX(-100%);
        }

        .te-timeline {
            position: relative;
            height: 80px;
            background: #000;
            border-radius: 12px;
            overflow: hidden;
            cursor: pointer;
            user-select: none;
        }

        .te-timeline-track {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
        }

        /* ============================================ */
        /* V13.0.0: FILMSTRIP FIX Äî SATU BARIS 12 FRAME */
        /* ============================================ */

        .te-filmstrip {
            position: absolute !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            bottom: 0 !important;
            display: flex !important;
            flex-direction: row !important;
            flex-wrap: nowrap !important;
            /* ≠ê KUNCI: jangan wrap */
            overflow: hidden !important;
            pointer-events: none !important;
            z-index: 3 !important;
            /* ≠ê di atas timeline-bg */
            width: 100% !important;
            height: 100% !important;
        }

        .te-filmstrip img {
            flex: 0 0 auto !important;
            /* ≠ê jangan grow/shrink */
            width: calc(100% / 12) !important;
            /* ≠ê bagi 12 sama rata */
            min-width: 0 !important;
            max-width: none !important;
            height: 100% !important;
            object-fit: cover !important;
            display: block !important;
            user-select: none !important;
            -webkit-user-drag: none !important;
        }

        .te-filmstrip-loading {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.75rem;
            color: var(--text-muted);
            background: rgba(0, 0, 0, 0.5);
            gap: 8px;
        }

        .te-timeline-bg {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: repeating-linear-gradient(90deg, transparent, transparent calc(10% - 1px), rgba(255, 255, 255, 0.1) calc(10% - 1px), rgba(255, 255, 255, 0.1) 10%);
            pointer-events: none;
            z-index: 2;
        }

        .te-segment {
            position: absolute;
            top: 12px;
            height: 56px;
            border-radius: 8px;
            cursor: pointer;
            transition: top 0.15s, height 0.15s, box-shadow 0.15s, background 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            min-width: 6px;
            padding: 0 6px;
            z-index: 5;
            backdrop-filter: blur(1px);
        }

        .te-segment.keep {
            background: transparent;
            border: 1.5px dashed rgba(255, 255, 255, 0.2);
            color: rgba(255, 255, 255, 0.5);
            box-shadow: none;
        }

        .te-segment.keep:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(255, 255, 255, 0.4);
            border-style: solid;
        }

        .te-segment.cut {
            /* Highlight merah tipis Äî supaya thumbnail tetap terlihat */
            background: linear-gradient(180deg,
                    rgba(239, 68, 68, 0.15) 0%,
                    rgba(239, 68, 68, 0.05) 50%,
                    rgba(239, 68, 68, 0.15) 100%);
            border: 2px solid rgba(239, 68, 68, 0.95);
            border-left: 3px solid rgba(239, 68, 68, 1);
            border-right: 3px solid rgba(239, 68, 68, 1);
            color: #fecaca;
            box-shadow: inset 0 0 0 1px rgba(239, 68, 68, 0.3);
        }

        .te-segment.cut:hover {
            background: rgba(239, 68, 68, 0.45);
        }

        .te-segment:hover {
            top: 6px;
            height: 68px;
            z-index: 10;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(255, 255, 255, 0.2);
        }

        .te-segment.selected {
            top: 4px;
            height: 72px;
            z-index: 15;
            box-shadow: 0 0 0 2px #fff, 0 6px 24px rgba(139, 92, 246, 0.6);
        }

        .te-segment.selected.cut {
            background: rgba(239, 68, 68, 0.5);
        }

        .te-segment.selected.keep {
            background: rgba(255, 255, 255, 0.1);
            border-style: solid;
        }

        .te-segment-label {
            font-size: 0.7rem;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 100%;
            pointer-events: none;
            color: #fff;
            text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95), 0 0 8px rgba(0, 0, 0, 0.7);
            background: rgba(0, 0, 0, 0.4);
            padding: 2px 6px;
            border-radius: 4px;
            backdrop-filter: blur(2px);
        }

        .te-segment.keep .te-segment-label {
            color: rgba(255, 255, 255, 0.75);
            background: rgba(0, 0, 0, 0.55);
            font-weight: 500;
        }

        .te-segment.cut .te-segment-label {
            color: #fff;
            background: rgba(120, 20, 20, 0.6);
        }

        .te-segment-handle {
            position: absolute;
            top: 0;
            bottom: 0;
            width: 10px;
            cursor: ew-resize;
            background: rgba(255, 255, 255, 0.2);
            transition: 0.15s;
            opacity: 0;
            z-index: 2;
        }

        .te-segment-handle:hover {
            background: rgba(255, 255, 255, 0.7);
        }

        .te-segment:hover .te-segment-handle {
            opacity: 1;
        }

        .te-segment-handle.left {
            left: 0;
            border-radius: 8px 0 0 8px;
        }

        .te-segment-handle.right {
            right: 0;
            border-radius: 0 8px 8px 0;
        }

        /* V3.0.2: Hide tooltip (user request) */
        .te-tooltip,
        .te-segment-tooltip,
        .te-timeline-hint-tip,
        .te-timeline-hint-tip2,
        [id*="tooltip"],
        [id*="Tooltip"],
        [class*="tooltip"],
        [class*="Tooltip"] {
            display: none !important;
            visibility: hidden !important;
            opacity: 0 !important;
            pointer-events: none !important;
        }

        .te-tooltip {
            position: fixed;
            background: rgba(15, 23, 42, 0.98);
            border: 1px solid rgba(139, 92, 246, 0.5);
            border-radius: 8px;
            padding: 8px 12px;
            font-size: 0.75rem;
            color: #e2e8f0;
            pointer-events: none;
            z-index: 9999;
            white-space: nowrap;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
            display: none;
        }

        .te-tooltip .te-tt-reason {
            font-weight: 700;
            margin-bottom: 2px;
            color: #a78bfa;
        }

        .te-tooltip .te-tt-time {
            color: #94a3b8;
            font-family: 'Courier New', monospace;
            font-size: 0.7rem;
        }

        .te-tooltip .te-tt-hint {
            color: #64748b;
            font-size: 0.68rem;
            margin-top: 4px;
            font-style: italic;
        }

        .te-playhead {
            position: absolute;
            top: -4px;
            bottom: -4px;
            width: 2px;
            background: #f59e0b;
            pointer-events: none;
            z-index: 20;
            box-shadow: 0 0 12px rgba(245, 158, 11, 0.8);
            transition: left 0.05s linear;
            left: 0;
        }

        .te-playhead-handle {
            position: absolute;
            top: -8px;
            left: 50%;
            transform: translateX(-50%);
            width: 14px;
            height: 14px;
            background: #f59e0b;
            border-radius: 50%;
            border: 2px solid #fff;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
        }

        .te-timeline.preview-mode .te-playhead {
            background: #22c55e;
            box-shadow: 0 0 16px rgba(34, 197, 94, 0.9);
        }

        .te-timeline.preview-mode .te-playhead-handle {
            background: #22c55e;
        }

        @keyframes teSegmentSkipped {

            0%,
            100% {
                box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
            }

            50% {
                box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.5);
            }
        }

        .te-segment.te-skipping {
            animation: teSegmentSkipped 0.5s ease-in-out;
        }

        .te-timeline-hint {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 10px;
            font-size: 0.72rem;
            color: var(--text-muted);
            padding: 0 4px;
        }

        .te-timeline-hint span {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .te-timeline-hint i {
            color: #8b5cf6;
            opacity: 0.8;
        }

        .te-preview-play-bar {
            margin: 16px 0 20px;
            padding: 14px;
            background: linear-gradient(135deg, rgba(34, 197, 94, 0.06), rgba(6, 182, 212, 0.06));
            border: 1px solid rgba(34, 197, 94, 0.25);
            border-radius: 14px;
        }

        .te-preview-play-btn {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 18px;
            border-radius: 12px;
            border: none;
            background: linear-gradient(135deg, #22c55e, #16a34a);
            color: white;
            cursor: pointer;
            transition: 0.25s;
            font-family: inherit;
            box-shadow: 0 4px 16px rgba(34, 197, 94, 0.4);
            text-align: left;
        }

        .te-preview-play-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(34, 197, 94, 0.6);
        }

        .te-preview-play-btn.playing {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            box-shadow: 0 4px 16px rgba(239, 68, 68, 0.4);
        }

        .te-ppb-icon-circle {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

        .te-ppb-icon-circle i {
            margin-left: 2px;
        }

        .te-preview-play-btn.playing .te-ppb-icon-circle i {
            margin-left: 0;
        }

        .te-ppb-text {
            display: flex;
            flex-direction: column;
            gap: 2px;
            flex: 1;
            min-width: 0;
        }

        .te-ppb-text strong {
            font-size: 0.95rem;
            font-weight: 800;
            letter-spacing: 0.2px;
        }

        .te-ppb-text small {
            font-size: 0.72rem;
            opacity: 0.9;
        }

        .te-preview-progress-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 10px;
            padding: 0 6px;
            font-size: 0.74rem;
        }

        .te-preview-time {
            color: var(--text-muted);
            font-family: 'Courier New', monospace;
            font-weight: 600;
        }

        .te-preview-live-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.4);
            color: #f87171;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.68rem;
            letter-spacing: 0.6px;
            animation: teLivePulse 1.5s ease-in-out infinite;
        }

        @keyframes teLivePulse {

            0%,
            100% {
                box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4);
            }

            50% {
                box-shadow: 0 0 0 4px rgba(239, 68, 68, 0);
            }
        }

        .te-live-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #ef4444;
            animation: teLiveDot 1s ease-in-out infinite;
        }

        @keyframes teLiveDot {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.3;
            }
        }

        .te-segment-info {
            display: flex;
            flex-direction: column;
            gap: 12px;
            padding: 16px;
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(139, 92, 246, 0.05));
            border: 1px solid rgba(139, 92, 246, 0.35);
            border-radius: 12px;
            margin-bottom: 16px;
            animation: teSlideIn 0.25s ease;
        }

        @keyframes teSlideIn {
            from {
                opacity: 0;
                transform: translateY(-4px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .te-si-main {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .te-si-icon {
            font-size: 1.4rem;
            flex-shrink: 0;
        }

        .te-si-body {
            flex: 1;
            min-width: 0;
        }

        .te-si-reason {
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 3px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .te-si-time {
            font-size: 0.75rem;
            color: var(--text-muted);
            font-family: 'Courier New', monospace;
        }

        .te-si-delete {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #ef4444;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            cursor: pointer;
            transition: 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .te-si-delete:hover {
            background: rgba(239, 68, 68, 0.3);
            border-color: #ef4444;
        }

        .te-si-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .te-si-action {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 3px;
            padding: 12px 10px;
            border-radius: 10px;
            border: 1.5px solid;
            cursor: pointer;
            transition: 0.2s;
            font-family: inherit;
            background: rgba(255, 255, 255, 0.03);
        }

        .te-si-action i {
            font-size: 1.1rem;
            margin-bottom: 2px;
        }

        .te-si-action span {
            font-size: 0.85rem;
            font-weight: 800;
            letter-spacing: 0.2px;
        }

        .te-si-action small {
            font-size: 0.68rem;
            opacity: 0.7;
            font-weight: 500;
        }

        .te-si-action.keep {
            border-color: rgba(255, 255, 255, 0.15);
            color: var(--text-muted);
            background: rgba(255, 255, 255, 0.02);
        }

        .te-si-action.keep:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 255, 255, 0.35);
            color: var(--text);
            transform: translateY(-1px);
        }

        .te-si-action.keep.active {
            background: rgba(255, 255, 255, 0.12);
            border-color: rgba(255, 255, 255, 0.5);
            color: #fff;
            box-shadow: 0 4px 16px rgba(255, 255, 255, 0.1);
        }

        .te-si-action.cut {
            border-color: rgba(239, 68, 68, 0.35);
            color: #f87171;
            background: rgba(239, 68, 68, 0.06);
        }

        .te-si-action.cut:hover {
            background: rgba(239, 68, 68, 0.15);
            border-color: rgba(239, 68, 68, 0.6);
            transform: translateY(-1px);
        }

        .te-si-action.cut.active {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            border-color: #ef4444;
            color: white;
            box-shadow: 0 4px 16px rgba(239, 68, 68, 0.4);
        }

        .te-actions {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .te-btn-primary {
            flex: 1;
            min-width: 200px;
            padding: 15px 24px;
            border-radius: 12px;
            border: none;
            background: linear-gradient(135deg, #8b5cf6, #06b6d4);
            color: white;
            font-size: 0.92rem;
            font-weight: 700;
            cursor: pointer;
            transition: 0.25s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 16px rgba(139, 92, 246, 0.4);
            font-family: inherit;
        }

        .te-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(139, 92, 246, 0.6);
        }

        .te-btn-primary:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        .te-btn-secondary {
            padding: 15px 20px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: var(--text);
            font-size: 0.88rem;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            font-family: inherit;
        }

        .te-btn-secondary:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.25);
        }

        .te-quality-bar {
            margin-top: 16px;
            padding: 14px 16px;
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.06), rgba(6, 182, 212, 0.04));
            border: 1px solid rgba(139, 92, 246, 0.2);
            border-radius: 12px;
        }

        .te-quality-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 10px;
            flex-wrap: wrap;
        }

        .te-quality-label {
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--text);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .te-quality-label i {
            color: #8b5cf6;
        }

        .te-quality-hint {
            font-size: 0.7rem;
            color: var(--text-muted);
            font-style: italic;
        }

        .te-quality-row {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .te-quality-select {
            flex: 1;
            min-width: 220px;
            padding: 12px 16px;
            background: rgba(0, 0, 0, 0.3);
            border: 1.5px solid rgba(139, 92, 246, 0.3);
            border-radius: 10px;
            color: var(--text);
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
            font-family: inherit;
            outline: none;
        }

        .te-quality-select:hover {
            border-color: rgba(139, 92, 246, 0.6);
            background: rgba(0, 0, 0, 0.4);
        }

        .te-quality-select:focus {
            border-color: #8b5cf6;
            box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.15);
        }

        .te-quality-select option {
            background: #1e1b2e;
            color: #fff;
            padding: 8px;
        }

        .te-quality-select option:disabled {
            color: #6b7280;
            font-style: italic;
        }

        .te-quality-upgrade {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 11px 16px;
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: white;
            border-radius: 10px;
            font-size: 0.78rem;
            font-weight: 700;
            text-decoration: none;
            transition: 0.2s;
            white-space: nowrap;
            box-shadow: 0 2px 8px rgba(245, 158, 11, 0.3);
        }

        .te-quality-upgrade:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(245, 158, 11, 0.5);
        }

        @media (max-width: 640px) {
            .te-header {
                flex-direction: column;
            }

            .te-close-btn {
                align-self: flex-end;
            }

            .te-stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .te-timeline {
                height: 68px;
            }

            .te-segment {
                top: 10px;
                height: 48px;
            }

            .te-segment:hover {
                top: 4px;
                height: 60px;
            }

            .te-timeline-hint {
                font-size: 0.68rem;
            }

            .te-actions {
                flex-direction: column;
            }

            .te-btn-primary {
                min-width: unset;
                width: 100%;
            }

            .te-ppb-text strong {
                font-size: 0.88rem;
            }

            .te-ppb-text small {
                font-size: 0.68rem;
            }

            .te-qm-buttons {
                grid-template-columns: 1fr;
            }

            .te-qm-btn {
                flex-direction: row;
                text-align: left;
                padding: 14px;
                gap: 14px;
            }

            .te-qm-icon {
                font-size: 1.5rem;
                flex-shrink: 0;
            }

            .te-qm-text {
                flex: 1;
            }

            .te-qm-badge {
                position: static;
                margin-left: auto;
            }

            .te-si-actions {
                grid-template-columns: 1fr;
            }

            .te-si-action {
                flex-direction: row;
                text-align: left;
                gap: 10px;
            }

            .te-si-action i {
                margin-bottom: 0;
            }

            .te-si-action small {
                margin-left: auto;
            }

            .te-legend-compact {
                font-size: 0.72rem;
            }

            .te-quality-row {
                flex-direction: column;
                align-items: stretch;
            }

            .te-quality-select {
                min-width: unset;
                width: 100%;
            }

            .te-quality-upgrade {
                justify-content: center;
            }

            .tr-lang-row {
                flex-direction: column;
                align-items: stretch;
            }

            .tr-lang-prefix {
                justify-content: center;
            }

            .tr-select {
                min-width: unset;
                width: 100%;
            }

            .compact-lock-card {
                flex-wrap: wrap;
                padding: 14px;
                gap: 12px;
            }

            .clc-icon {
                width: 40px;
                height: 40px;
                font-size: 1.2rem;
            }

            .clc-title {
                font-size: 0.85rem;
            }

            .clc-desc {
                font-size: 0.68rem;
            }

            .clc-btn {
                width: 100%;
                justify-content: center;
                padding: 11px 18px;
                font-size: 0.8rem;
                margin-top: 2px;
            }
        }

        /* ============================================================ */
        /* V10.4.0: STATS EDITOR Äî LEBIH LEBAR & RAPI                   */
        /* ============================================================ */

        /* Container stats Äî full width */
        .te-stats {
            display: grid !important;
            grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
            gap: 14px !important;
            margin: 0 0 20px 0 !important;
            padding: 16px !important;
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.08), rgba(6, 182, 212, 0.05)) !important;
            border: 1px solid rgba(139, 92, 246, 0.2) !important;
            border-radius: 16px !important;
            width: 100% !important;
            box-sizing: border-box !important;
            overflow: hidden !important;
        }

        /* Setiap kotak */
        .te-stat-item {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
            text-align: center !important;
            padding: 16px 8px !important;
            background: rgba(0, 0, 0, 0.25) !important;
            border-radius: 12px !important;
            border: 1px solid rgba(255, 255, 255, 0.06) !important;
            transition: 0.2s !important;
            min-width: 0 !important;
            overflow: hidden !important;
            box-sizing: border-box !important;
        }

        .te-stat-item:hover {
            background: rgba(0, 0, 0, 0.35) !important;
            border-color: rgba(139, 92, 246, 0.4) !important;
            transform: translateY(-2px) !important;
        }

        /* Label Äî kecil, uppercase, JANGAN wrap */
        .te-stat-label {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 5px !important;
            font-size: 0.68rem !important;
            font-weight: 700 !important;
            color: #94a3b8 !important;
            text-transform: uppercase !important;
            letter-spacing: 0.4px !important;
            margin-bottom: 6px !important;
            line-height: 1 !important;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            max-width: 100% !important;
        }

        .te-stat-label i {
            font-size: 0.78rem !important;
            color: #8b5cf6 !important;
            flex-shrink: 0 !important;
        }

        /* Value Äî besar, JANGAN wrap */
        .te-stat-value {
            font-size: 1.5rem !important;
            font-weight: 800 !important;
            color: #fff !important;
            line-height: 1 !important;
            letter-spacing: -0.5px !important;
            margin-bottom: 4px !important;
            white-space: nowrap !important;
            max-width: 100% !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
        }

        .te-stat-value.success {
            color: #22c55e !important;
        }

        .te-stat-value.danger {
            color: #ef4444 !important;
        }

        .te-stat-value.primary {
            color: #a78bfa !important;
        }

        /* Detail Äî kecil, JANGAN wrap */
        .te-stat-detail {
            font-size: 0.62rem !important;
            color: #64748b !important;
            font-weight: 500 !important;
            line-height: 1 !important;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            max-width: 100% !important;
        }

        /* ============================================================ */
        /* TABLET: 641px - 1024px Üí 2x2 GRID                             */
        /* ============================================================ */
        @media (max-width: 1024px) and (min-width: 641px) {
            .te-stats {
                grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
                gap: 12px !important;
                padding: 14px !important;
            }

            .te-stat-value {
                font-size: 1.4rem !important;
            }
        }

        /* ============================================================ */
        /* MOBILE: < 640px Üí 1 KOLOM VERTIKAL                            */
        /* ============================================================ */
        @media (max-width: 640px) {
            .te-stats {
                grid-template-columns: 1fr !important;
                gap: 8px !important;
                padding: 12px !important;
            }

            .te-stat-item {
                display: grid !important;
                grid-template-columns: auto 1fr auto !important;
                align-items: center !important;
                gap: 10px !important;
                padding: 12px 14px !important;
                text-align: left !important;
            }

            .te-stat-label {
                justify-content: flex-start !important;
                margin-bottom: 0 !important;
                font-size: 0.72rem !important;
                white-space: normal !important;
            }

            .te-stat-value {
                font-size: 1.3rem !important;
                margin-bottom: 0 !important;
                justify-self: end !important;
                grid-column: 2 !important;
            }

            .te-stat-detail {
                grid-column: 1 / -1 !important;
                text-align: right !important;
                font-size: 0.68rem !important;
                white-space: normal !important;
                margin-top: 2px !important;
            }
        }

        /* ============================================================ */
        /* MOBILE KECIL: < 380px                                         */
        /* ============================================================ */
        @media (max-width: 380px) {
            .te-stat-value {
                font-size: 1.1rem !important;
            }

            .te-stat-label {
                font-size: 0.65rem !important;
            }

            .te-stat-detail {
                font-size: 0.6rem !important;
            }
        }

        /* ============================================================ */
        /* V11.0.0: STATS EDITOR Äî WARNA + VISUAL HIERARCHY (AMAN)      */
        /* ============================================================ */

        .te-stats {
            display: grid !important;
            grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
            gap: 12px !important;
            margin: 0 0 20px 0 !important;
            padding: 14px !important;
            background: rgba(0, 0, 0, 0.2) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
            border-radius: 16px !important;
            width: 100% !important;
            box-sizing: border-box !important;
            overflow: hidden !important;
        }

        .te-stat-item {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
            text-align: center !important;
            padding: 16px 10px !important;
            background: rgba(0, 0, 0, 0.25) !important;
            border-radius: 12px !important;
            border: 1px solid rgba(255, 255, 255, 0.06) !important;
            border-left-width: 4px !important;
            transition: 0.2s !important;
            min-width: 0 !important;
            overflow: hidden !important;
            box-sizing: border-box !important;
            position: relative !important;
        }

        /* --- WARNA PER KOTAK --- */

        /* Biru Äî Durasi Asli */
        .te-stat-blue {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.12), rgba(59, 130, 246, 0.03)) !important;
            border-color: rgba(59, 130, 246, 0.2) !important;
            border-left-color: #3b82f6 !important;
        }

        .te-stat-blue .te-stat-label i {
            color: #3b82f6 !important;
        }

        .te-stat-blue .te-stat-value {
            color: #60a5fa !important;
        }

        /* Merah Äî Dipotong */
        .te-stat-red {
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.12), rgba(239, 68, 68, 0.03)) !important;
            border-color: rgba(239, 68, 68, 0.2) !important;
            border-left-color: #ef4444 !important;
        }

        .te-stat-red .te-stat-label i {
            color: #ef4444 !important;
        }

        .te-stat-red .te-stat-value {
            color: #f87171 !important;
        }

        /* Hijau Äî Hasil Akhir (HIGHLIGHT) */
        .te-stat-green {
            background: linear-gradient(135deg, rgba(34, 197, 94, 0.18), rgba(34, 197, 94, 0.05)) !important;
            border-color: rgba(34, 197, 94, 0.35) !important;
            border-left-color: #22c55e !important;
        }

        .te-stat-green .te-stat-label i {
            color: #22c55e !important;
        }

        .te-stat-green .te-stat-value {
            color: #4ade80 !important;
        }

        /* Highlight HASIL */
        .te-stat-highlight {
            box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.3), 0 4px 16px rgba(34, 197, 94, 0.15) !important;
        }

        /* Ungu Äî Segmen */
        .te-stat-purple {
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.12), rgba(139, 92, 246, 0.03)) !important;
            border-color: rgba(139, 92, 246, 0.2) !important;
            border-left-color: #8b5cf6 !important;
        }

        .te-stat-purple .te-stat-label i {
            color: #8b5cf6 !important;
        }

        .te-stat-purple .te-stat-value {
            color: #a78bfa !important;
        }

        /* --- LABEL & VALUE --- */

        .te-stat-label {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 5px !important;
            font-size: 0.68rem !important;
            font-weight: 800 !important;
            color: #94a3b8 !important;
            text-transform: uppercase !important;
            letter-spacing: 0.6px !important;
            margin-bottom: 8px !important;
            line-height: 1 !important;
            white-space: nowrap !important;
            max-width: 100% !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
        }

        .te-stat-label i {
            font-size: 0.8rem !important;
            flex-shrink: 0 !important;
        }

        .te-stat-value {
            font-size: 1.5rem !important;
            font-weight: 800 !important;
            color: #fff !important;
            line-height: 1 !important;
            letter-spacing: -0.5px !important;
            white-space: nowrap !important;
            max-width: 100% !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
        }

        /* Hover */
        .te-stat-item:hover {
            transform: translateY(-3px) !important;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4) !important;
        }

        /* --- RESPONSIVE --- */

        @media (max-width: 1024px) and (min-width: 641px) {
            .te-stats {
                grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
                gap: 10px !important;
                padding: 12px !important;
            }

            .te-stat-value {
                font-size: 1.3rem !important;
            }
        }

        @media (max-width: 640px) {
            .te-stats {
                grid-template-columns: 1fr !important;
                gap: 8px !important;
                padding: 10px !important;
            }

            .te-stat-item {
                display: grid !important;
                grid-template-columns: auto 1fr auto !important;
                align-items: center !important;
                gap: 10px !important;
                padding: 12px 14px !important;
                text-align: left !important;
                border-left-width: 4px !important;
            }

            .te-stat-label {
                justify-content: flex-start !important;
                margin-bottom: 0 !important;
                font-size: 0.72rem !important;
            }

            .te-stat-value {
                font-size: 1.2rem !important;
                justify-self: end !important;
            }
        }

        /* ============================================================ */
        /* V11.0.0: DESKTOP OPTIMIZATION Äî LEBIH BESAR & LEGA          */
        /* ============================================================ */

        /* Editor wrap Äî full width untuk desktop */
        .timeline-editor-wrap {
            max-width: 100% !important;
            width: 100% !important;
            box-sizing: border-box !important;
            margin: 0 auto !important;
            padding: 32px !important;
        }

        /* Player Äî LEBIH BESAR */
        .te-player-wrap {
            max-width: 100% !important;
            width: 100% !important;
            margin: 0 auto 24px !important;
            aspect-ratio: 16/9 !important;
            max-height: 700px !important;
        }

        /* Stats Äî LEBIH BESAR */
        .te-stats {
            display: grid !important;
            grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
            gap: 18px !important;
            margin: 0 0 28px 0 !important;
            padding: 22px !important;
            background: rgba(0, 0, 0, 0.2) !important;
            border: 1px solid rgba(255, 255, 255, 0.05) !important;
            border-radius: 18px !important;
            width: 100% !important;
            box-sizing: border-box !important;
        }

        .te-stat-item {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
            text-align: center !important;
            padding: 22px 14px !important;
            background: rgba(0, 0, 0, 0.25) !important;
            border-radius: 14px !important;
            border: 1px solid rgba(255, 255, 255, 0.06) !important;
            border-left-width: 5px !important;
            transition: 0.2s !important;
            min-width: 0 !important;
            overflow: hidden !important;
            box-sizing: border-box !important;
        }

        .te-stat-label {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 6px !important;
            font-size: 0.82rem !important;
            font-weight: 800 !important;
            color: #94a3b8 !important;
            text-transform: uppercase !important;
            letter-spacing: 0.7px !important;
            margin-bottom: 12px !important;
            line-height: 1 !important;
            white-space: nowrap !important;
        }

        .te-stat-label i {
            font-size: 0.95rem !important;
            flex-shrink: 0 !important;
        }

        .te-stat-value {
            font-size: 2rem !important;
            font-weight: 800 !important;
            color: #fff !important;
            line-height: 1 !important;
            letter-spacing: -0.6px !important;
            white-space: nowrap !important;
        }

        /* Tablet: 2x2 grid */
        @media (max-width: 1024px) and (min-width: 641px) {
            .te-stats {
                grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
                gap: 14px !important;
                padding: 16px !important;
            }

            .te-stat-value {
                font-size: 1.6rem !important;
            }
        }

        /* Mobile: 1 kolom */
        @media (max-width: 640px) {
            .timeline-editor-wrap {
                padding: 16px !important;
            }

            .te-stats {
                grid-template-columns: 1fr !important;
                gap: 10px !important;
                padding: 12px !important;
            }

            .te-stat-item {
                display: grid !important;
                grid-template-columns: auto 1fr auto !important;
                align-items: center !important;
                gap: 12px !important;
                padding: 14px 16px !important;
                text-align: left !important;
            }

            .te-stat-label {
                justify-content: flex-start !important;
                margin-bottom: 0 !important;
                font-size: 0.75rem !important;
            }

            .te-stat-value {
                font-size: 1.4rem !important;
                justify-self: end !important;
            }
        }

        /* ============================================ */
        /* RESPONSIVE FIX Äî MOBILE & TABLET            */
        /* ============================================ */

        /* --- TABLET (max 1024px) --- */
        @media (max-width: 1024px) {
            .timeline-editor-wrap {
                padding: 16px !important;
                max-width: 100% !important;
            }

            .te-qm-buttons {
                grid-template-columns: repeat(2, 1fr) !important;
            }

            .qa-grid {
                grid-template-columns: repeat(2, 1fr) !important;
            }

            .te-format-grid {
                grid-template-columns: repeat(3, 1fr) !important;
            }
        }

        /* --- MOBILE (max 640px) --- */
        @media (max-width: 640px) {
            .render-main {
                padding: 16px 10px 40px !important;
            }

            .render-header h1 {
                font-size: 1.3rem !important;
            }

            .render-header p {
                font-size: 0.8rem !important;
            }

            .timeline-editor-wrap {
                padding: 12px !important;
                border-radius: 12px !important;
            }

            /* Player video full width */
            .te-player-wrap {
                max-height: 250px !important;
                border-radius: 8px !important;
            }

            /* Header editor */
            .te-header h3 {
                font-size: 1rem !important;
            }

            .te-subtitle {
                font-size: 0.75rem !important;
            }

            /* Quick mode buttons jadi 1 kolom */
            .te-qm-buttons {
                grid-template-columns: 1fr !important;
                gap: 8px !important;
            }

            /* Aksi cepat jadi 1 kolom */
            .qa-grid {
                grid-template-columns: 1fr !important;
            }

            /* Format export jadi 3 kecil */
            .te-format-grid {
                grid-template-columns: repeat(3, 1fr) !important;
                gap: 6px !important;
            }

            .te-format-btn {
                padding: 8px 4px !important;
            }

            .te-format-name {
                font-size: 0.65rem !important;
            }

            /* Timeline lebih pendek */
            .te-timeline {
                height: 60px !important;
            }

            .te-segment {
                top: 8px !important;
                height: 44px !important;
            }

            /* Tombol utama full width */
            .te-actions {
                flex-direction: column !important;
            }

            .te-btn-primary,
            .te-btn-secondary {
                width: 100% !important;
                justify-content: center !important;
            }

            /* Quality selector full width */
            .te-quality-row {
                flex-direction: column !important;
                align-items: stretch !important;
            }

            .te-quality-select {
                width: 100% !important;
                min-width: unset !important;
            }

            /* Translate bar */
            .te-translate-row {
                flex-direction: column !important;
                align-items: stretch !important;
            }

            .te-translate-select-wrap {
                min-width: unset !important;
                width: 100% !important;
            }

            /* Segment info */
            .te-si-actions {
                grid-template-columns: 1fr !important;
            }
        }

        /* --- MOBILE KECIL (max 380px) --- */
        @media (max-width: 380px) {
            .te-stat-value {
                font-size: 1.1rem !important;
            }

            .render-header h1 {
                font-size: 1.1rem !important;
            }
        }

        /* ============================================ */
        /* V12.0.0: SEGMEN CUT Äî TRANSPARAN LEBIH TIPIS */
        /* Thumbnail harus tetap terlihat di bawah      */
        /* ============================================ */

        /* Segmen yang akan dipotong Äî pakai border + overlay sangat tipis */
        .te-segment.cut {
            background: rgba(239, 68, 68, 0.08) !important;
            /* overlay cuma 8% */
            border: 2px solid rgba(239, 68, 68, 0.9) !important;
            box-shadow:
                inset 0 0 0 1px rgba(255, 255, 255, 0.1),
                0 0 0 1px rgba(239, 68, 68, 0.3) !important;
            backdrop-filter: none !important;
            /* jangan blur thumbnail */
        }

        .te-segment.cut:hover {
            background: rgba(239, 68, 68, 0.2) !important;
            /* hover: sedikit lebih merah */
        }

        /* Segmen yang dipilih (selected) Äî tetap highlight */
        .te-segment.cut.selected {
            background: rgba(239, 68, 68, 0.25) !important;
            box-shadow:
                0 0 0 2px #fff,
                0 6px 24px rgba(139, 92, 246, 0.6),
                inset 0 0 0 2px rgba(239, 68, 68, 0.5) !important;
        }

        /* Label segmen Äî pastikan masih terbaca di atas thumbnail */
        .te-segment.cut .te-segment-label {
            background: rgba(120, 20, 20, 0.85) !important;
            color: #fff !important;
            text-shadow: 0 1px 3px rgba(0, 0, 0, 0.95) !important;
        }

        /* Segmen "keep" (tidak dipotong) Äî tetap transparan */
        .te-segment.keep {
            background: transparent !important;
            border: 1.5px dashed rgba(255, 255, 255, 0.3) !important;
        }

/* ============================================================ */
/* V1.0.0: VOICE OVER ACCORDION STYLING                         */
/* ============================================================ */
details#voiceoverSection summary::-webkit-details-marker {
    display: none;
}
details#voiceoverSection summary {
    list-style: none;
}
details#voiceoverSection[open] summary i.fa-chevron-down {
    transform: rotate(180deg);
}
details#voiceoverSection summary:hover {
    background: rgba(139, 92, 246, 0.1) !important;
    border-color: rgba(139, 92, 246, 0.3) !important;
}




    </style>