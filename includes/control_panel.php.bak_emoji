            <!-- ================= VOICE OVER & TRANSLATE SCRIPTS ================= -->
            <?php if (!$cpIsFree || $cpIsAdmin): ?>
                <script>
                    (function() {
                        /* ---------- AI VOICE OVER ---------- */
                        const vo = {
                            text: document.getElementById('voText'),
                            voice: document.getElementById('voVoice'),
                            btn: document.getElementById('voGenerateBtn'),
                            result: document.getElementById('voResult'),
                            player: document.getElementById('voPlayer'),
                            download: document.getElementById('voDownloadBtn'),
                            reset: document.getElementById('voResetBtn')
                        };

                        if (vo.btn) {
                            let currentVoiceUrl = null;

                            vo.btn.addEventListener('click', async () => {
                                const text = vo.text.value.trim();
                                const voice = vo.voice.value;

                                if (!text) return window.toastError && window.toastError('ö†∏èØ∏è Tulis script dulu');
                                if (text.length > 5000) return window.toastError && window.toastError('ö†∏èØ∏è Maks 5000 karakter');

                                vo.btn.disabled = true;
                                vo.btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generating...';

                                try {
                                    const auth = window.CLIPORA_AUTH || {};
                                    const r = await fetch((auth.apiUrl || '/api') + '/voiceover/generate', {
                                        method: 'POST',
                                        headers: {
                                            'Content-Type': 'application/json',
                                            'Authorization': 'Bearer ' + (auth.token || '')
                                        },
                                        body: JSON.stringify({
                                            text,
                                            voice
                                        })
                                    });

                                    const data = await r.json();
                                    if (!data.success) throw new Error(data.error || 'Gagal generate');

                                    currentVoiceUrl = (auth.baseUrl || '') + data.url;
                                    vo.player.src = currentVoiceUrl;
                                    vo.result.style.display = 'block';

                                    if (window.toastSuccess) window.toastSuccess(`úÖ Voice over jadi! (${data.size_kb} KB)`);
                                } catch (e) {
                                    console.error(e);
                                    if (window.toastError) window.toastError('¢ùí ' + e.message);
                                } finally {
                                    vo.btn.disabled = false;
                                    vo.btn.innerHTML = '<i class="fas fa-wand-magic-sparkles"></i> Generate';
                                }
                            });

                            vo.download.addEventListener('click', () => {
                                if (!currentVoiceUrl) return;
                                const a = document.createElement('a');
                                a.href = currentVoiceUrl;
                                a.download = 'voiceover.mp3';
                                document.body.appendChild(a);
                                a.click();
                                a.remove();
                            });

                            vo.reset.addEventListener('click', () => {
                                vo.text.value = '';
                                vo.result.style.display = 'none';
                                vo.player.src = '';
                                currentVoiceUrl = null;
                            });
                        }
                    })();

                    (function() {
                        /* ---------- MULTI-BAHASA TRANSLATE ---------- */
                        const tr = {
                            text: document.getElementById('trText'),
                            target: document.getElementById('trTargetLang'),
                            btn: document.getElementById('trTranslateBtn'),
                            result: document.getElementById('trResult'),
                            resultLang: document.getElementById('trResultLang'),
                            resultProvider: document.getElementById('trResultProvider'),
                            resultText: document.getElementById('trResultText'),
                            copy: document.getElementById('trCopyBtn'),
                            reset: document.getElementById('trResetBtn')
                        };

                        if (tr.btn) {
                            let currentTranslation = '';

                            // Ambil elemen progress
const trProgressContainer = document.getElementById('trProgressContainer');
const trProgressFill = document.getElementById('trProgressFill');
const trProgressText = document.getElementById('trProgressText');

tr.btn.addEventListener('click', async () => {
    const text = tr.text.value.trim();
    const to = tr.target.value;

    if (!text) return window.toastError && window.toastError('ö†∏è Tempel teks dulu');

    // Tampilkan progress bar
    if (trProgressContainer) trProgressContainer.style.display = 'block';
    if (trProgressFill) trProgressFill.style.width = '10%';
    if (trProgressText) trProgressText.textContent = 'Menghubungi server... 10%';

    tr.btn.disabled = true;
    tr.btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Translating...';

    try {
        const auth = window.CLIPORA_AUTH || {};
        // Simulasi progress naik sedikit sebelum request selesai
        if (trProgressFill) trProgressFill.style.width = '30%';
        if (trProgressText) trProgressText.textContent = 'Menerjemahkan teks... 30%';

        const r = await fetch((auth.apiUrl || '/api') + '/translate', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': 'Bearer ' + (auth.token || '')
            },
            body: JSON.stringify({ text, from: 'id', to })
        });

        // Progress naik setelah response diterima
        if (trProgressFill) trProgressFill.style.width = '80%';
        if (trProgressText) trProgressText.textContent = 'Menyelesaikan... 80%';

        const data = await r.json();
        if (!data.success) throw new Error(data.error || 'Translate gagal');

        currentTranslation = data.translated;
        tr.resultLang.textContent = tr.target.options[tr.target.selectedIndex].text;
        tr.resultProvider.textContent = 'via ' + (data.provider || 'auto');
        tr.resultText.textContent = data.translated;
        tr.result.style.display = 'block';

        // Progress selesai 100%
        if (trProgressFill) trProgressFill.style.width = '100%';
        if (trProgressText) trProgressText.textContent = 'Selesai! 100%';

        if (window.toastSuccess) window.toastSuccess('úÖ Berhasil diterjemahkan!');

        // Sembunyikan progress setelah 1 detik
        setTimeout(() => {
            if (trProgressContainer) trProgressContainer.style.display = 'none';
        }, 1000);

    } catch (e) {
        console.error(e);
        if (window.toastError) window.toastError('ùå ' + e.message);
        if (trProgressFill) trProgressFill.style.width = '0%';
        if (trProgressText) trProgressText.textContent = 'Gagal.';
        setTimeout(() => {
            if (trProgressContainer) trProgressContainer.style.display = 'none';
        }, 2000);
    } finally {
        tr.btn.disabled = false;
        tr.btn.innerHTML = '<i class="fas fa-language"></i> Translate';
    }
});

                            tr.copy.addEventListener('click', async () => {
                                if (!currentTranslation) return;
                                try {
                                    await navigator.clipboard.writeText(currentTranslation);
                                    if (window.toastSuccess) window.toastSuccess('ìã Copied!');
                                } catch {
                                    if (window.toastError) window.toastError('Gagal copy');
                                }
                            });

                            tr.reset.addEventListener('click', () => {
                                tr.text.value = '';
                                tr.result.style.display = 'none';
                                currentTranslation = '';
                            });

                            // Auto-grow textarea
                            const trText = document.getElementById('trText');
                            if (trText) {
                                const autoGrow = () => {
                                    trText.style.height = 'auto';
                                    trText.style.height = Math.min(trText.scrollHeight, 140) + 'px';
                                };
                                trText.addEventListener('input', autoGrow);
                                setTimeout(autoGrow, 100);
                            }
                        }
                    })();
                </script>
            <?php endif; ?>

        </div>
    <?php endif; ?>

