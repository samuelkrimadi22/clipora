    text-transform: uppercase;
    font-weight: 600;
    animation: csTextFade 0.8s ease-out 0.4s both;
}
@keyframes csTextFade {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
}
.cs-progress {
    width: 220px;
    height: 3px;
    background: rgba(245, 158, 11, 0.15);
    border-radius: 3px;
    overflow: hidden;
