}
#cliporaSplash.hide {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
}
.cs-logo-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 140px;
    height: 140px;
}
.cs-logo-img {
    width: 96px;
